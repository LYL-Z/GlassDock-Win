<Window x:Class="GlassDock.Experimental.Wpf.ApplicationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add applications to GlassDock" Width="620" Height="650"
        MinWidth="480" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="#FFF2F4F8" ShowInTaskbar="False"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Add applications" FontSize="22" FontWeight="SemiBold" Foreground="#FF1E2430" />
            <TextBlock Text="Choose from the current Windows Start Menu and AppsFolder catalog. Nothing is pinned automatically."
                       Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#FF576274" />
        </StackPanel>
        <TextBox x:Name="SearchBox" Grid.Row="2" Height="38" Padding="10,7"
                 VerticalContentAlignment="Center" FontSize="14"
                 AutomationProperties.Name="Search applications"
                 TextChanged="SearchBox_TextChanged" />
        <ListView x:Name="ApplicationsList" Grid.Row="4" SelectionMode="Single"
                  MouseDoubleClick="ApplicationsList_MouseDoubleClick"
                  AutomationProperties.Name="Available Windows applications">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4" AutomationProperties.Name="{Binding DisplayName}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="10" Background="#FFE0E6EF">
                            <Grid>
                                <Image Source="{Binding Icon}" Width="34" Height="34" Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="{Binding Fallback}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="#FF39465A">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Medium"
                                       Foreground="#FF1E2430" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding IdentitySummary}" FontSize="10" Foreground="#FF697588"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <DockPanel Grid.Row="6" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Pin selected" MinWidth="110" Padding="12,7"
                    IsDefault="True" Click="PinButton_Click" AutomationProperties.Name="Pin selected application" />
            <Button DockPanel.Dock="Right" Content="Close" MinWidth="82" Padding="12,7" Margin="0,0,8,0"
                    IsCancel="True" />
            <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Foreground="#FF576274"
                       TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </Grid>
</Window>
