<Window x:Class="GlassDock.Experimental.Wpf.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassDock Experimental Preview"
        Width="420" Height="120" MinWidth="100" MinHeight="100"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="False"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="DockTileButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#72FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Backplate" Margin="22" Padding="10,8"
            CornerRadius="38" Background="#E91B1F28"
            BorderBrush="#46FFFFFF" BorderThickness="1"
            SnapsToDevicePixels="True"
            MouseRightButtonUp="Backplate_MouseRightButtonUp">
        <Border.Effect>
            <DropShadowEffect Color="#A0000000" BlurRadius="18" ShadowDepth="4" Opacity="0.38" />
        </Border.Effect>
        <ScrollViewer x:Name="SectionsScrollViewer"
                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                      CanContentScroll="False" Focusable="False" PanningMode="HorizontalOnly"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel x:Name="SectionsHost" Orientation="Horizontal" VerticalAlignment="Center" />
        </ScrollViewer>
    </Border>
</Window>
