<Window x:Class="GlassDock.PoC.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassDock-Win WPF spike"
        Width="580" Height="132"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="Transparent">
        <Border x:Name="GlassPanel" Margin="8" Padding="12,8"
                CornerRadius="28" Background="#A82B3341"
                BorderBrush="#55FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#100C18" Opacity="0.44" BlurRadius="22" ShadowDepth="7" />
            </Border.Effect>
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Sample profile">
                        <MenuItem Header="8 placeholders" Click="SetEight_Click" />
                        <MenuItem Header="24 placeholders" Click="SetTwentyFour_Click" />
                    </MenuItem>
                    <MenuItem Header="Icon size">
                        <MenuItem Header="Small · 44 DIP" Click="SetSmall_Click" />
                        <MenuItem Header="Default · 58 DIP" Click="SetDefaultSize_Click" />
                        <MenuItem Header="Large · 72 DIP" Click="SetLarge_Click" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Bottom edge" Click="SetBottom_Click" />
                    <MenuItem Header="Left edge" Click="SetLeft_Click" />
                    <MenuItem Header="Right edge" Click="SetRight_Click" />
                    <Separator />
                    <MenuItem Header="Exit GlassDock" Click="Exit_Click" />
                </ContextMenu>
            </Border.ContextMenu>
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom"
                           Margin="0,4,0,0" HorizontalAlignment="Center"
                           FontFamily="Segoe UI" FontSize="10" Foreground="#BFFFFFFF"
                           Text="8 local placeholders · starting…" />
                <StackPanel x:Name="ItemsStack" Orientation="Horizontal" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
